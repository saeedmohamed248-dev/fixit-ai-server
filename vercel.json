{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/parts/:c/:m",
      "destination": "/api/category?c=:c&m=:m"
    },
    {
      "source": "/oem/:n",
      "destination": "/api/oem?n=:n"
    },
    {
      "source": "/guide",
      "destination": "/api/guide"
    },
    {
      "source": "/guide/:s",
      "destination": "/api/guide?s=:s"
    },
    {
      "source": "/en/p/:id",
      "destination": "/api/item?id=:id&lang=en"
    },
    {
      "source": "/parts/:c",
      "destination": "/api/category?c=:c"
    },
    {
      "source": "/p/:id",
      "destination": "/api/item?id=:id"
    },
    {
      "source": "/bmw/:m",
      "destination": "/api/car?m=:m"
    },
    {
      "source": "/mini/:m",
      "destination": "/api/car?m=:m"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance?cron=1",
      "schedule": "0 9 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(assets|mobile-assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}