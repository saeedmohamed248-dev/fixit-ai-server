{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/bmw/:m",
      "destination": "/api/car?m=:m"
    },
    {
      "source": "/mini/:m",
      "destination": "/api/car?m=:m"
    }
  ],
  "crons": [
    {
      "path": "/api/maintenance?cron=1",
      "schedule": "0 9 * * *"
    }
  ]
}
